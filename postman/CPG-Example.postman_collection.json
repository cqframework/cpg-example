{
  "info": {
    "_postman_id": "00cf7b76-e4f9-43c6-95e2-132962c950af",
    "name": "CPG Example",
    "description": "Run `$apply` for each CQL test case against a local FHIR server.\nLoad the conformance resources first with `node bin/load-fhir-server.js`; do not load the test data, as each request passes its test case inline as the `data` parameter (the same way cpg-review does).\n\nRequest bodies are generated from `input/examples/Bundle-<TestCase>.json` by `node bin/build-test-bundles.js`; re-run it after changing test data. `Needs…` cases should propose an order; the others should not.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "DailyAppleRecommendation",
      "description": "Test cases from `input/tests/Library/DailyAppleLogic`.",
      "item": [
        {
          "name": "HasDailyAppleOrder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const carePlan = pm.response.json();",
                  "pm.test(\"Returns a CarePlan\", () => pm.expect(carePlan.resourceType).to.eql(\"CarePlan\"));",
                  "",
                  "const proposed = (carePlan.contained || []).map(r => r.resourceType);",
                  "pm.test(\"Proposes no MedicationRequest\", () => pm.expect(proposed).to.not.include(\"MedicationRequest\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              },
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "url": {
